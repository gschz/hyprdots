$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh

/* To enable blur please make sure alpha is greater than 0 */
@define-color bar-bg rgba(0, 0, 0, 0.1); 

@define-color main-bg #0D0D0D;
@define-color main-fg #E0E0E0;

@define-color wb-act-bg #a855f7;
@define-color wb-act-fg #0D0D0D;

@define-color wb-hvr-bg #7c3aed;
@define-color wb-hvr-fg #E0E0E0;
